<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{titulo}}</title>

  <style>
    :root{
      --primary:#0f3b66;
      --border:#d7d7d7;
      --text:#111;
      --muted:#555;
      --soft:#f5f7fb;
      --totalbg:#eef3fb;
      --totalborder:#cfe0fb;
    }

    body{
      font-family: Arial, Helvetica, sans-serif;
      margin: 28px 34px;
      color: var(--text);
      background: #fff;
    }

    .header{ margin-bottom: 14px; }
    .org{
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    h1{
      font-size: 20px;
      margin: 0;
      color: var(--primary);
      line-height: 1.2;
    }

    .desc{
      font-size: 12.5px;
      line-height: 1.55;
      margin: 10px 0 16px 0;
      max-width: 980px;
      text-align: justify;
      color: #222;
    }

    .card{
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 18px;
      background: #fff;
      box-shadow: 0 1px 2px rgba(0,0,0,.06);
      max-width: 1020px;
      margin: 0 auto;
    }

    table{
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 13px;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    thead th{
      background: var(--primary);
      color: #fff;
      padding: 10px 12px;
      text-align: center;
      font-weight: 700;
      border-right: 1px solid rgba(255,255,255,.15);
      white-space: nowrap;
    }
    thead th:last-child{ border-right: none; }

    tbody td{
      padding: 9px 12px;
      border-top: 1px solid var(--border);
      text-align: center;
      background: #fff;
    }

    tbody td:first-child{
      text-align: left;
      width: 45%;
    }
    tbody td:nth-child(2){
      width: 25%;
    }
    tbody td:nth-child(3){
      width: 30%;
      font-weight: 700;
    }

    tbody tr:nth-child(even) td{
      background: var(--soft);
    }

    tbody tr.total-row td{
      font-weight: 700;
      background: var(--totalbg) !important;
      border-top: 2px solid var(--primary);
    }

    .total-box{
      margin: 18px auto 0 auto;
      max-width: 560px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 18px;
      border-radius: 12px;
      background: var(--totalbg);
      border: 1px solid var(--totalborder);
      box-shadow: 0 1px 2px rgba(0,0,0,.06);
    }
    .total-label{
      font-size: 13.5px;
      font-weight: 700;
      color: var(--primary);
    }
    .total-value{
      font-size: 20px;
      font-weight: 800;
      color: #0b2b4b;
    }

    .footer{
      margin-top: 14px;
      font-size: 11px;
      color: var(--muted);
      text-align: center;
    }
  </style>
</head>

<body>

  <div class="header">
    <div class="org">Universidad Católica Andrés Bello (UCAB) – Plataforma SoyUCAB</div>
    <h1>{{titulo}}</h1>
  </div>

  <p class="desc">{{descripcion}}</p>

  <div class="card">

    <table>
      <thead>
        <tr>
          <th>Nombre del Usuario</th>
          <th>Rol</th>
          <th>Publicaciones Realizadas</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          <tr class="{{#if isTotal}}total-row{{/if}}">
            <td>{{nombre_usuario}}</td>
            <td>{{rol}}</td>
            <td>{{publicaciones_realizadas}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="total-box">
      <div class="total-label">Total de Publicaciones</div>
      <div class="total-value">{{totalPublicaciones}}</div>
    </div>

  </div>

  <div class="footer">
    Reporte generado por el sistema SoyUCAB
  </div>

</body>
</html>