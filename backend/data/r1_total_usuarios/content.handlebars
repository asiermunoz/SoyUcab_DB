<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Reporte - Usuarios Registrados</title>

  <style>
    :root{
      --primary:#0f3b66;
      --border:#d7d7d7;
      --text:#111;
      --muted:#555;
      --soft:#f5f7fb;
    }

    body{
      font-family: Arial, Helvetica, sans-serif;
      margin: 28px 34px;
      color: var(--text);
      background: #fff;
    }

    /* ===== ENCABEZADO ===== */
    .header{
      margin-bottom: 16px;
    }

    .org{
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 4px;
    }

    h1{
      font-size: 20px;
      margin: 0;
      color: var(--primary);
    }

    .desc{
      font-size: 12.5px;
      line-height: 1.55;
      margin: 12px 0 18px 0;
      text-align: justify;
    }

    /* ===== TABLA ===== */
    table{
      width: 65%;
      margin: 0 auto;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 13px;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    thead th{
      background: var(--primary);
      color: #fff;
      padding: 10px 12px;
      text-align: center;
      font-weight: 700;
    }

    tbody td{
      padding: 9px 12px;
      border-top: 1px solid var(--border);
      text-align: center;
      background: #fff;
    }

    tbody td:first-child{
      text-align: left;
    }

    tbody tr:nth-child(even) td{
      background: var(--soft);
    }

    tbody tr.total-row td{
      font-weight: 700;
      background: #eef3fb !important;
      border-top: 2px solid var(--primary);
    }

    /* ===== CUADRO TOTAL ===== */
    .total-box{
      margin: 22px auto 0 auto;
      max-width: 420px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 18px;
      border-radius: 12px;
      background: #eef3fb;
      border: 1px solid #cfe0fb;
      box-shadow: 0 1px 2px rgba(0,0,0,.06);
    }

    .total-label{
      font-size: 13.5px;
      font-weight: 700;
      color: var(--primary);
    }

    .total-value{
      font-size: 20px;
      font-weight: 800;
      color: #0b2b4b;
    }

    /* ===== PIE ===== */
    .footer{
      margin-top: 14px;
      font-size: 11px;
      color: var(--muted);
      text-align: center;
    }
  </style>
</head>

<body>

  <!-- ENCABEZADO -->
  <div class="header">
    <div class="org">Universidad Católica Andrés Bello (UCAB) – Plataforma SoyUCAB</div>
  </div>

  <!-- TABLA -->
  <table>
    <thead>
      <tr>
        <th>Tipo de Usuario</th>
        <th>Cantidad Registrada</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
        <tr class="{{#if isTotal}}total-row{{/if}}">
          <td>{{tipo_usuario}}</td>
          <td>{{cantidad_registrada}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- CUADRO TOTAL -->
  <div class="total-box">
    <div class="total-label">Total de Usuarios Registrados</div>
    <div class="total-value">{{totalUsuarios}}</div>
  </div>

  <!-- PIE -->
  <div class="footer">
    Reporte generado por el sistema SoyUCAB
  </div>

</body>
</html>

